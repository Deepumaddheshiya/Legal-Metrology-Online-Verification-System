# LMOVS System Environment Variables
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Authentication & Security
NEXTAUTH_SECRET="your-secure-nextauth-secret-key-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-secure-jwt-secret-key"

# Expiry Cron & Background Tasks
CRON_SECRET="your-secure-cron-secret-key"

# SMS Service (Mock or Provider)
ENABLE_MOCK_SMS="true"
SMS_GATEWAY_API_KEY="your-sms-api-key"
SMS_SENDER_ID="LMOVSG"

# Email Dispatcher (Resend)
RESEND_API_KEY="re_your_resend_api_key"
FROM_EMAIL="no-reply@lmovs.gov.in"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_QR_VERIFICATION_URL="http://localhost:3000/verify"
